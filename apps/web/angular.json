{
  "version": 1,
  "projects": {
    "web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": [{ "glob": "**/*", "input": "public", "output": "/" }]
          },
          "configurations": {
            "pages": {
              "outputPath": "dist/pages",
              "fileReplacements": [
                { "replace": "src/app/demo-mode.ts", "with": "src/app/demo-mode.pages.ts" }
              ],
              "budgets": [{ "type": "initial", "maximumWarning": "1MB", "maximumError": "2MB" }],
              "outputHashing": "all"
            },
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "1MB", "maximumError": "2MB" }],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "web:build:development" },
            "pages": { "buildTarget": "web:build:pages" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
